# ---------- Logto ----------
LOGTO_ENDPOINT=https://auth.haori.ink
# Machine-to-machine app used for the Management API (role: Logto Management API access)
LOGTO_M2M_CLIENT_ID=
LOGTO_M2M_CLIENT_SECRET=
LOGTO_MANAGEMENT_RESOURCE=https://default.logto.app/api
# Webhook signing key (Console > Webhooks > signing key)
LOGTO_WEBHOOK_SIGNING_KEY=
# Social connector target (identity key). Verified on auth.haori.ink: capital T
IDP_TARGET=Telegram
# Traditional app that lands the one-time login link on the Logto account center.
# Create it with redirectUris = ["https://auth.haori.ink/"] (see scripts/create-logto-resources.ts)
LOGIN_APP_CLIENT_ID=
LOGIN_REDIRECT_URI=https://auth.haori.ink/
# One-time token lifetime in seconds (Logto default 600)
OTT_TTL=600

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=
# Value passed to setWebhook(secret_token); incoming updates must carry X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
BOT_PUBLIC_URL=
# Comma separated telegram user ids allowed to run admin commands
ADMIN_TG_IDS=

# ---------- Runtime ----------
PORT=8080
HOST=0.0.0.0
DB_PATH=./data/bot.db
LOG_LEVEL=info
# Never call the real Telegram Bot API (used for local dry runs / tests)
DRY_RUN=false
# Comma separated set of notifications enabled by default for new bindings
NOTIFY_DEFAULTS=signin,password,security,account

# ---------- Outbound proxy (optional) ----------
# http://127.0.0.1:7890 | https://proxy:8443 | socks5://user:pass@host:1080 | socks5h://host:1080
TELEGRAM_PROXY_URL=
LOGTO_PROXY_URL=
# When the vars above are empty, fall back to HTTPS_PROXY / ALL_PROXY from the environment
PROXY_USE_ENV_FALLBACK=true
PROXY_NO_PROXY=

# ---------- Telegram update transport ----------
# webhook: needs a public HTTPS endpoint
# polling: outbound getUpdates only (works behind a proxy / no inbound port)
TELEGRAM_MODE=webhook
TELEGRAM_POLL_TIMEOUT=30

# ---------- Outbound WebSocket relay (Bot API over wss://) ----------
# Run `pnpm tsx scripts/ws-relay.ts` on a host that can reach api.telegram.org
TELEGRAM_WS_RELAY=
TELEGRAM_WS_RELAY_TOKEN=

# ---------- Local WebSocket control channel ----------
WS_ENABLED=false
WS_TOKEN=
